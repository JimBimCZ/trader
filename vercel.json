{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/out",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{frontend/**,test/**,docs/**,planning/**,scripts/**,backend/tests/**,backend/.venv/**,backend/uv.lock,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "env": {
    "LLM_MOCK": "true",
    "STREAM_MAX_SECONDS": "55"
  },
  "crons": [{ "path": "/api/admin/cleanup", "schedule": "0 4 * * *" }]
}
