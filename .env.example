# Copy to .env and fill in your values: cp .env.example .env

# Required: Postgres connection string.
#
# `docker compose up` ignores this and uses its own postgres container; set it
# for running the backend directly on the host, or to point at a Neon database.
# Neon's string carries `channel_binding=require`, which asyncpg rejects — the
# app strips it, so paste the string exactly as Neon gives it to you.
DATABASE_URL=postgresql://trader:trader@localhost:5432/trader

# Required: OpenRouter API key for LLM chat functionality
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Required in production: signs the session cookie that identifies a user.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left unset, an ephemeral one is generated at startup -- every restart then
# signs out every user and permanently orphans every guest portfolio.
SESSION_SECRET=

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in GBM market simulator (recommended for most
# users — no API quota consumed). Any non-empty value switches to live data.
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (E2E tests, CI,
# or development without an API key)
LLM_MOCK=false

# --- Optional tuning (all have sensible defaults) ---

# Seed for the market simulator's RNG. Set to any integer to make price paths
# reproducible — required for non-flaky E2E assertions about price movement.
SIM_SEED=

# Simulator tick interval in milliseconds (default 500). The GBM time step is
# derived from this, so a faster tick gives proportionally smaller moves, not
# livelier ones. Use SIM_VOL_MULTIPLIER for that.
SIM_TICK_MS=500

# Scales every ticker's volatility (default 1.0 = realistic). Real intraday
# moves are only cents per second, which looks static in a short demo. Try 25
# for visible movement, 100 for dramatic. Does not affect Massive mode.
SIM_VOL_MULTIPLIER=1.0

# Massive API poll interval in seconds (default 15, sized for the free tier's
# 5 calls/min). Paid tiers can go as low as 2.
MASSIVE_POLL_SECONDS=15

# Postgres schema every table is confined to (default: empty, meaning
# "public"). Production has no reason to set this; the test suite gives each
# test its own throwaway schema.
DB_SCHEMA=

# "simulator" (stateful GBM ticking on a background task) or "deterministic"
# (a pure function of the clock, for platforms with no background task, e.g.
# Vercel). Default: empty, which resolves to "deterministic" when the VERCEL
# env var is set and "simulator" otherwise. Ignored if MASSIVE_API_KEY is set.
MARKET_SOURCE=

# Seconds after which the SSE price stream closes itself so the client
# reconnects (default 0 = never, i.e. hold the connection open indefinitely —
# fine for the container deployment, required on a platform with a
# per-invocation time limit).
STREAM_MAX_SECONDS=0
